{
  "name": "intervalmap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "codecheck": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run ls-lint && pnpm run knip",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "knip": "knip",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix",
    "ls-lint": "ls-lint",
    "prepare": "lefthook install",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@ls-lint/ls-lint": "2.3.1",
    "@types/node": "26.2.0",
    "knip": "6.32.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.7.0"
  },
  "packageManager": "pnpm@11.21.0"
}
