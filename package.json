{
  "name": "intervalmap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "codecheck": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run knip",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "knip": "knip",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "knip": "6.31.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0"
}
