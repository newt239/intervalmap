{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    ".expo/",
    ".wrangler/",
    "apps/mobile/ios/",
    "apps/mobile/android/",
    "apps/api/drizzle/**"
  ],
  "sortImports": {
    "groups": [
      "react",
      ["value-builtin", "value-external"],
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      ["type-parent", "type-sibling", "type-index"],
      "type-internal",
      "type-import",
      "unknown"
    ],
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react-native", "expo", "expo-*"]
      }
    ],
    "internalPattern": ["#/", "@intervalmap/"],
    "newlinesBetween": true,
    "order": "asc",
    "ignoreCase": true
  },
  "sortPackageJson": {
    "sortScripts": true
  }
}
